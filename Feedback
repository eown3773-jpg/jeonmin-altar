<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>청소년 사목 결산 & 사목 식별 피드백 시스템</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Google Fonts (Noto Sans KR) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Noto Sans KR', sans-serif;
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col">

  <!-- Top Navigation Header -->
  <header class="bg-indigo-900 text-white shadow-md sticky top-0 z-40">
    <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <span class="text-2xl">✝️</span>
        <div>
          <h1 class="font-bold text-base md:text-lg leading-tight">청소년 사목 결산 & 식별 피드백</h1>
          <p class="text-xs text-indigo-200">주님 안에서 함께 성장하는 본당 공동체</p>
        </div>
      </div>
      
      <!-- Role / View Mode Switcher -->
      <div class="flex items-center bg-indigo-950/60 p-1 rounded-xl border border-indigo-700/50">
        <button id="navUserBtn" onclick="switchView('user')" class="px-3.5 py-1.5 rounded-lg text-xs md:text-sm font-medium transition-all duration-200 bg-indigo-600 text-white shadow-sm flex items-center gap-1.5">
          <i data-lucide="edit-3" class="w-4 h-4"></i> 피드백 작성
        </button>
        <button id="navAdminBtn" onclick="handleAdminAccessClick()" class="px-3.5 py-1.5 rounded-lg text-xs md:text-sm font-medium transition-all duration-200 text-indigo-200 hover:text-white flex items-center gap-1.5">
          <i data-lucide="shield-check" class="w-4 h-4"></i> 보좌신부 식별함
          <span id="badgeCount" class="ml-1 bg-amber-500 text-slate-900 text-xs px-1.5 py-0.2 rounded-full font-bold hidden">0</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Container -->
  <main class="flex-1 max-w-6xl w-full mx-auto p-4 md:p-6 lg:p-8">

    <!-- ============================================== -->
    <!-- VIEW 1: 응답자 (교사회/자모회/청년회) 피드백 폼 -->
    <!-- ============================================== -->
    <div id="userView" class="max-w-2xl mx-auto space-y-6">
      
      <!-- 제출 완료 시 나타나는 감사 화면 (결과 비공개 보호) -->
      <div id="submitSuccessCard" class="hidden bg-white rounded-2xl shadow-sm border border-emerald-200 p-8 text-center space-y-4 animate-in fade-in zoom-in-95">
        <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto shadow-inner">
          <i data-lucide="check" class="w-8 h-8"></i>
        </div>
        <div>
          <h3 class="text-xl font-bold text-slate-900">소중한 피드백이 전해졌습니다</h3>
          <p class="text-xs md:text-sm text-slate-600 mt-2 leading-relaxed">
            나눠주신 진솔한 말씀은 <strong>보좌신부의 기도와 식별함으로 안전하게 보관</strong>됩니다.<br>
            다른 이들에게 원문이 공개되지 않으며, 사목적 배려를 담아 공동체에 선익이 되는 방향으로 전달하겠습니다.
          </p>
        </div>
        <div class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row justify-center gap-2">
          <button type="button" onclick="resetFormForNewSubmission()" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs md:text-sm font-medium transition flex items-center justify-center gap-1.5 shadow-sm">
            <i data-lucide="plus-circle" class="w-4 h-4"></i> 다른 행사 피드백 추가 작성
          </button>
        </div>
      </div>

      <!-- 본 피드백 폼 컨테이너 -->
      <div id="formSection" class="space-y-6">
        <!-- 안내 공지 카드 (신부님의 완충 및 식별 철학 전달) -->
        <div class="bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-200/80 rounded-2xl p-5 shadow-sm text-slate-700 space-y-2.5">
          <div class="flex items-start gap-3">
            <div class="p-2 bg-amber-500 text-white rounded-xl shadow-sm mt-0.5">
              <i data-lucide="heart-handshake" class="w-5 h-5"></i>
            </div>
            <div>
              <h2 class="font-bold text-slate-900 text-base flex items-center gap-2">
                솔직하고 진솔한 나눔을 부탁드립니다
              </h2>
              <p class="text-xs md:text-sm text-slate-600 mt-1 leading-relaxed">
                본 조사는 1년 사목을 돌아보고 더 나은 방향을 모색하기 위한 설문입니다. 
                <strong>결과와 작성 내용은 일반에 공개되지 않으며, 보좌신부 1인만이 열람하고 기도와 식별 과정</strong>을 거쳐 
                상처가 아닌 건설적인 배움과 사랑의 양식이 되도록 정제하여 단체에 전해집니다. 안심하시고 편안하게 적어주세요.
              </p>
            </div>
          </div>
        </div>

        <!-- 설문 양식 카드 -->
        <form id="feedbackForm" onsubmit="handleSubmit(event)" class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8 space-y-6">
          
          <!-- 1. 단체 선택 -->
          <div>
            <label class="block text-sm font-bold text-slate-900 mb-2">
              1. 소속 단체를 선택해주세요 <span class="text-rose-500">*</span>
            </label>
            <div id="groupOptionsContainer" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              <!-- JS 동적 생성 -->
            </div>
          </div>

          <!-- 2. 나눔 대상 (자유 입력 & 간편 칩 선택) -->
          <div class="border-t border-slate-200 pt-5 space-y-2">
            <div class="flex items-center justify-between">
              <label class="block text-sm font-bold text-slate-900">
                2. 어떤 행사나 활동에 대해 나누고 싶으신가요?
              </label>
              <span class="text-[11px] text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded-md font-medium">자유 입력</span>
            </div>
            <p class="text-xs text-slate-500">
              정확한 행사 이름이 아니어도 괜찮습니다. 생각나는 활동이나 평소 아쉬웠던 점을 적어주세요.
            </p>

            <!-- 빠른 선택 태그 (터치 한 번으로 입력) -->
            <div class="flex flex-wrap gap-1.5 pt-1">
              <button type="button" onclick="setQuickTopic('첫영성체 교리 및 소통')" class="text-xs bg-slate-100 hover:bg-indigo-50 hover:text-indigo-700 text-slate-700 px-2.5 py-1 rounded-full border border-slate-200 transition">
                🕊️ 첫영성체 교리/소통
              </button>
              <button type="button" onclick="setQuickTopic('주일미사 및 전례')" class="text-xs bg-slate-100 hover:bg-indigo-50 hover:text-indigo-700 text-slate-700 px-2.5 py-1 rounded-full border border-slate-200 transition">
                ⛪ 주일미사/전례
              </button>
              <button type="button" onclick="setQuickTopic('여름 신앙학교/캠프')" class="text-xs bg-slate-100 hover:bg-indigo-50 hover:text-indigo-700 text-slate-700 px-2.5 py-1 rounded-full border border-slate-200 transition">
                🏕️ 여름캠프
              </button>
              <button type="button" onclick="setQuickTopic('성탄/부활 축제')" class="text-xs bg-slate-100 hover:bg-indigo-50 hover:text-indigo-700 text-slate-700 px-2.5 py-1 rounded-full border border-slate-200 transition">
                🎄 성탄/부활 행사
              </button>
              <button type="button" onclick="setQuickTopic('평소 단체 운영 및 소통')" class="text-xs bg-slate-100 hover:bg-indigo-50 hover:text-indigo-700 text-slate-700 px-2.5 py-1 rounded-full border border-slate-200 transition">
                💬 평소 소통/모임
              </button>
            </div>

            <input type="text" id="eventSelect" required placeholder="예: 첫영성체 부모 모임, 여름캠프 식사 준비, 평소 공지 등" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none transition">
          </div>

          <!-- 3. KPT 관점 피드백 입력 -->
            </div>
            <p class="text-xs text-indigo-600/90 mb-2">단체에 전혀 공유되지 않고, 신부님 사목 묵상에만 참조됩니다.</p>
            <textarea id="privateText" rows="2" placeholder="단체 내 인간관계, 개인적 고충 등 신부님께만 털어놓고 싶은 말씀이 있다면 적어주세요." class="w-full bg-white border border-indigo-200 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none transition resize-y"></textarea>
          </div>
        </div>

        <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3 rounded-xl shadow-md transition duration-200 flex items-center justify-center gap-2">
          <i data-lucide="send" class="w-4 h-4"></i> 피드백 제출하기 (보좌신부에게만 전달)
        </button>
      </form>
      </div>
    </div>

    <!-- ============================================== -->
    <!-- VIEW 2: 보좌신부 전용 사목 식별 및 가공 대시보드 -->
    <!-- ============================================== -->
    <div id="adminView" class="hidden space-y-6">

      <!-- 상단 컨트롤 바 & 통계 요약 -->
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2">
            <h2 class="text-lg md:text-xl font-bold text-slate-900 flex items-center gap-2">
              <span>🕊️</span> 사목 식별 & 피드백 정제소
            </h2>
            <span class="bg-indigo-100 text-indigo-800 text-[11px] font-semibold px-2 py-0.5 rounded-full flex items-center gap-1">
              <i data-lucide="lock" class="w-3 h-3"></i> 신부님 전용 잠금 해제됨
            </span>
          </div>
          <p class="text-xs text-slate-500 mt-1">
            접수된 생생한 목소리를 묵상하여, 단체에 힘이 되는 사목 제안으로 다듬어 전달합니다.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <!-- 단체 필터 -->
          <select id="adminGroupFilter" onchange="renderAdminList()" class="bg-slate-50 border border-slate-300 rounded-lg text-xs md:text-sm px-3 py-2 text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500">
            <option value="ALL">전체 단체 보기</option>
            <!-- 동적 옵션 -->
          </select>

          <!-- 상태 필터 -->
          <select id="adminStatusFilter" onchange="renderAdminList()" class="bg-slate-50 border border-slate-300 rounded-lg text-xs md:text-sm px-3 py-2 text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500">
            <option value="ALL">전체 상태</option>
            <option value="PENDING">식별 대기중 (미가공)</option>
            <option value="REVIEWED">식별 완료 (정제됨)</option>
          </select>

          <!-- 일괄 내보내기 버튼 -->
          <button onclick="openExportModal()" class="bg-slate-800 hover:bg-slate-900 text-white text-xs md:text-sm px-3.5 py-2 rounded-lg font-medium flex items-center gap-1.5 transition shadow-sm">
            <i data-lucide="file-text" class="w-4 h-4"></i> 단체 전달용 보고서
          </button>

          <!-- 보안 로그아웃 버튼 -->
          <button onclick="lockAdminSession()" title="식별함 잠금" class="border border-rose-200 text-rose-600 hover:bg-rose-50 text-xs md:text-sm px-3 py-2 rounded-lg font-medium flex items-center gap-1 transition">
            <i data-lucide="log-out" class="w-4 h-4"></i> 잠금/로그아웃
          </button>
        </div>
      </div>

      <!-- 리스트 & 카드 레이아웃 -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        <!-- 왼쪽: 피드백 리스트 -->
        <div class="lg:col-span-5 space-y-3">
          <div class="flex items-center justify-between px-1">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider" id="listSummaryText">
              접수된 피드백 목록
            </span>
            <span class="text-xs text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded-full font-medium" id="totalCountBadge">
              총 0건
            </span>
          </div>
          <div id="feedbackList" class="space-y-3 max-h-[700px] overflow-y-auto custom-scrollbar pr-1">
            <!-- JS 동적 렌더링 -->
          </div>
        </div>

        <!-- 오른쪽: 신부님 식별 및 가공 에디터 -->
        <div class="lg:col-span-7">
          <div id="editorPanel" class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sticky top-20 min-h-[500px]">
            <div id="emptyEditorState" class="h-96 flex flex-col items-center justify-center text-center text-slate-400">
              <i data-lucide="inbox" class="w-12 h-12 stroke-[1.5] mb-2 text-slate-300"></i>
              <p class="font-medium text-slate-600 text-sm">목록에서 피드백을 선택해주세요</p>
              <p class="text-xs text-slate-400 mt-1">원문을 읽고, 단체에 전달할 정제 문구를 작성할 수 있습니다.</p>
            </div>

            <!-- 활성화된 에디터 컨텐츠 -->
            <div id="activeEditorContent" class="hidden space-y-5">
              <!-- 헤더 정보 -->
              <div class="border-b border-slate-200 pb-4">
                <div class="flex items-center justify-between">
                  <span id="detailGroupBadge" class="px-2.5 py-1 rounded-md text-xs font-semibold"></span>
                  <span id="detailDate" class="text-xs text-slate-400"></span>
                </div>
                <h3 id="detailEventTitle" class="text-lg font-bold text-slate-900 mt-2"></h3>
              </div>

              <!-- 1. 원본 피드백 내용 (있는 그대로) -->
              <div class="bg-slate-50 rounded-xl p-4 border border-slate-200 space-y-3 text-sm">
                <div class="font-semibold text-xs text-slate-500 uppercase tracking-wider flex items-center gap-1">
                  <i data-lucide="message-square" class="w-3.5 h-3.5"></i> 원본 피드백 (비공개 원문)
                </div>
                
                <div id="rawKeepSection" class="space-y-0.5">
                  <span class="text-xs font-semibold text-emerald-700">👍 좋았던 점 (Keep):</span>
                  <p id="detailKeep" class="text-slate-700 whitespace-pre-line text-xs pl-2 bg-white/70 p-2 rounded-lg border border-emerald-100"></p>
                </div>

                <div class="space-y-0.5">
                  <span class="text-xs font-semibold text-amber-700">⚠️ 아쉬운 점 (Problem):</span>
                  <p id="detailProblem" class="text-slate-700 whitespace-pre-line text-xs pl-2 bg-white/70 p-2 rounded-lg border border-amber-100"></p>
                </div>

                <div id="rawTrySection" class="space-y-0.5">
                  <span class="text-xs font-semibold text-indigo-700">💡 개선 제안 (Try):</span>
                  <p id="detailTry" class="text-slate-700 whitespace-pre-line text-xs pl-2 bg-white/70 p-2 rounded-lg border border-indigo-100"></p>
                </div>

                <!-- 비밀 나눔 -->
                <div id="detailPrivateContainer" class="hidden pt-2 border-t border-slate-200">
                  <span class="text-xs font-semibold text-purple-700 flex items-center gap-1">
                    <i data-lucide="lock" class="w-3 h-3"></i> 신부님께만 드린 비밀 나눔:
                  </span>
                  <p id="detailPrivate" class="text-slate-600 italic whitespace-pre-line text-xs pl-2 bg-purple-50/50 p-2 rounded-lg border border-purple-100 mt-1"></p>
                </div>
              </div>

              <!-- 2. 신부님의 식별 & 전달용 정제 에디터 -->
              <div class="bg-amber-50/40 rounded-xl p-4 border border-amber-200 space-y-3">
                <div class="flex items-center justify-between">
                  <div class="font-bold text-xs text-amber-900 uppercase tracking-wider flex items-center gap-1.5">
                    <i data-lucide="pen-tool" class="w-4 h-4 text-amber-600"></i> 단체 전달용 정제 메모 (보좌신부의 식별)
                  </div>
                  <span class="text-[11px] text-amber-700 font-medium">※ 이 내용만 단체로 공유됩니다</span>
                </div>

                <div class="space-y-1">
                  <label class="block text-xs font-medium text-slate-700">상처 주지 않고 건설적인 '사목적 전달 메시지'로 변환</label>
                  <textarea id="refinedFeedbackText" rows="4" placeholder="예: [안내/일정] 행사 당일 봉사자 배치 및 타임테이블을 사전 2주 전에 공유하여 각 단체가 여유 있게 준비할 수 있도록 시스템 보완 필요." class="w-full bg-white border border-amber-300 rounded-lg p-3 text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none transition resize-y"></textarea>
                </div>

                <!-- 빠른 변환 제안 도우미 -->
                <div class="flex flex-wrap gap-1.5 pt-1">
                  <button type="button" onclick="insertRefinedTemplate('communication')" class="text-[11px] bg-white hover:bg-amber-100 text-amber-800 border border-amber-200 px-2 py-1 rounded">💬 수도자/사목자-자모회 소통 완충</button>
                  <button type="button" onclick="insertRefinedTemplate('time')" class="text-[11px] bg-white hover:bg-amber-100 text-amber-800 border border-amber-200 px-2 py-1 rounded">⏱️ 일정/공지 사전공유 보완</button>
                  <button type="button" onclick="insertRefinedTemplate('role')" class="text-[11px] bg-white hover:bg-amber-100 text-amber-800 border border-amber-200 px-2 py-1 rounded">🤝 자모회-교사회 업무분담 명확화</button>
                  <button type="button" onclick="insertRefinedTemplate('budget')" class="text-[11px] bg-white hover:bg-amber-100 text-amber-800 border border-amber-200 px-2 py-1 rounded">💰 예산 및 물품 사전점검</button>
                  <button type="button" onclick="insertRefinedTemplate('keep')" class="text-[11px] bg-white hover:bg-amber-100 text-amber-800 border border-amber-200 px-2 py-1 rounded">👏 우수 사례 칭찬 및 격려</button>
                </div>

                <div class="flex items-center justify-between pt-2">
                  <label class="flex items-center gap-2 text-xs text-slate-700 cursor-pointer">
                    <input type="checkbox" id="markAsReviewedCheck" class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500">
                    <span class="font-medium">식별 및 정제 완료 상태로 표시</span>
                  </label>

