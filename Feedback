  <!-- Application Logic -->
  <script>
    // 1. 단체 목록 정의 (신부님께서 제시하신 대상 단체)
    const TARGET_GROUPS = [
      { id: "elem_mom", name: "초등부 자모회", badge: "bg-blue-100 text-blue-800 border-blue-200" },
      { id: "elem_teacher", name: "초등부 교사회", badge: "bg-sky-100 text-sky-800 border-sky-200" },
      { id: "midhigh_mom", name: "중고등부 자모회", badge: "bg-emerald-100 text-emerald-800 border-emerald-200" },
      { id: "midhigh_teacher", name: "중고등부 교사회", badge: "bg-teal-100 text-teal-800 border-teal-200" },
      { id: "communion_teacher", name: "첫영성체 교사회", badge: "bg-purple-100 text-purple-800 border-purple-200" },
      { id: "communion_mom", name: "첫영성체 자모회", badge: "bg-fuchsia-100 text-fuchsia-800 border-fuchsia-200" },
      { id: "youth", name: "청년회", badge: "bg-amber-100 text-amber-800 border-amber-200" }
    ];

    // 초기 샘플 데이터 (신부님 확인 및 시연용)
    const INITIAL_FEEDBACKS = [
      {
        id: "fb-1",
        groupId: "elem_mom",
        groupName: "초등부 자모회",
        event: "여름 신앙학교/캠프",
        keep: "아이들이 성당 마당에서 물놀이하며 신부님, 교사들과 친해질 수 있어서 정말 좋았습니다. 간식 준비도 자모들끼리 협업이 잘 되었습니다.",
        problem: "물놀이 후 탈의실 안내가 너무 혼란스러웠고, 자모회에 간식 수량 변경 공지가 당일 아침에 급하게 전달되어 음식이 부족할 뻔했습니다.",
        tryText: "식단표와 알레르기 조사, 시간표는 적어도 2주 전에 확정되어 자모회에 공유되었으면 좋겠습니다.",
        privateNote: "일부 자모님들이 교사회가 소통을 늦게 해준다고 서운해하셨습니다. 신부님께서 온화하게 다리 역할을 해주시면 감사하겠습니다.",
        createdAt: "2026-11-02 14:20",
        refinedText: "[신앙학교 운영] 물놀이 및 세부 동선(탈의실 등) 사전 안내를 강화하고, 자모회 간식 준비 수량 등 협조 요청 사항은 행사 최소 2주 전 사전 확정 공지하여 원활한 협업 유도.",
        isReviewed: true
      },
      {
        id: "fb-2",
        groupId: "midhigh_teacher",
        groupName: "중고등부 교사회",
        event: "1년 사목 전반 및 주일미사/교리",
        keep: "시험 기간 전례 쉼터 운영과 청소년 미사 때 신부님의 강론이 학생들 눈높이에 맞춰져 출석률이 올랐습니다.",
        problem: "교사 숫자가 너무 적어 매주 교리 준비와 미사 반주, 성가 지도가 한두 사람에게 과중하게 쏠리고 있습니다. 지쳐서 내년에 그만두겠다는 교사가 있습니다.",
        tryText: "청년회나 학부모님들 중 미사 반주 봉사자 1명이라도 지원 연계를 해주시면 교사들이 본래 교리 교육에 집중할 수 있을 것 같습니다.",
        privateNote: "교사들 사기가 많이 떨어져 있습니다. 신부님과 교사들만의 따뜻한 피정이나 삼겹살 회식이 한번 꼭 필요합니다.",
        createdAt: "2026-11-05 19:40",
        refinedText: "",
        isReviewed: false
      },
      {
        id: "fb-3",
        groupId: "communion_mom",
        groupName: "첫영성체 자모회",
        event: "첫영성체 교리 및 예식",
        keep: "아이들이 첫영성체 전 매일 기도문 외우며 신앙심이 훌쩍 큰 것이 느껴졌습니다. 신부님의 안수와 축복도 감동적이었습니다.",
        problem: "부모 대상 교육 일정이 평일 저녁에만 잡혀서 맞벌이 부모들은 참석하기가 너무 어려웠고 죄책감이 들었습니다.",
        tryText: "학부모 교리는 주일 교리 시간 중이나 온라인 영상 수강을 병행할 수 있게 해주시면 좋겠습니다.",
        privateNote: "",
        createdAt: "2026-11-07 10:15",
        refinedText: "",
        isReviewed: false
      }
    ];

    // 메모리 내 데이터 상태
    let feedbacks = [...INITIAL_FEEDBACKS];
    let selectedFeedbackId = null;
    let selectedGroupRadio = null;

    // 보좌신부 보안 인증 상태
    let isAdminAuthenticated = false;
    let adminSecurityPin = "7777"; // 기본 비밀번호 (신부님 전용)

    // 초기화
    window.addEventListener('DOMContentLoaded', () => {
      initGroupSelection();
      initFilterDropdowns();
      renderAdminList();
      updateBadges();
      lucide.createIcons();
    });

    // 보좌신부 식별함 탭 클릭 시 보안 확인
    function handleAdminAccessClick() {
      if (isAdminAuthenticated) {
        switchView('admin');
      } else {
        openAdminAuthModal();
      }
    }

    // 비밀번호 모달 열기/닫기
    function openAdminAuthModal() {
      const modal = document.getElementById('adminAuthModal');
      const input = document.getElementById('adminPasswordInput');
      const errorMsg = document.getElementById('authErrorMsg');
      input.value = '';
      errorMsg.classList.add('hidden');
      modal.classList.remove('hidden');
      setTimeout(() => input.focus(), 100);
      lucide.createIcons();
    }

    function closeAdminAuthModal() {
      document.getElementById('adminAuthModal').classList.add('hidden');
    }

    // 비밀번호 검증
    function verifyAdminPassword(e) {
      e.preventDefault();
      const entered = document.getElementById('adminPasswordInput').value.trim();
      const errorMsg = document.getElementById('authErrorMsg');

      if (entered === adminSecurityPin) {
        isAdminAuthenticated = true;
        closeAdminAuthModal();
        switchView('admin');
        showToast("보좌신부님, 환영합니다. 식별함이 열렸습니다.");
      } else {
        errorMsg.classList.remove('hidden');
      }
    }

    // 신부님 세션 잠금(로그아웃)
    function lockAdminSession() {
      isAdminAuthenticated = false;
      switchView('user');
      showToast("보좌신부 식별함이 안전하게 잠겼습니다.");
    }

    // 뷰 전환 (작성자 폼 vs 보좌신부 식별함)
    function switchView(view) {
      const userView = document.getElementById('userView');
      const adminView = document.getElementById('adminView');
      const navUserBtn = document.getElementById('navUserBtn');
      const navAdminBtn = document.getElementById('navAdminBtn');

      if (view === 'user') {
        userView.classList.remove('hidden');
        adminView.classList.add('hidden');
        navUserBtn.className = "px-3.5 py-1.5 rounded-lg text-xs md:text-sm font-medium transition-all bg-indigo-600 text-white shadow-sm flex items-center gap-1.5";
        navAdminBtn.className = "px-3.5 py-1.5 rounded-lg text-xs md:text-sm font-medium transition-all text-indigo-200 hover:text-white flex items-center gap-1.5";
      } else {
        // 관리자 인증이 안 된 경우 튕겨내기
        if (!isAdminAuthenticated) {
          openAdminAuthModal();
          return;
        }
        userView.classList.add('hidden');
        adminView.classList.remove('hidden');
        navAdminBtn.className = "px-3.5 py-1.5 rounded-lg text-xs md:text-sm font-medium transition-all bg-indigo-600 text-white shadow-sm flex items-center gap-1.5";
        navUserBtn.className = "px-3.5 py-1.5 rounded-lg text-xs md:text-sm font-medium transition-all text-indigo-200 hover:text-white flex items-center gap-1.5";
        renderAdminList();
      }
      lucide.createIcons();
    }

    // 작성 폼 단체 선택 라디오 렌더링
    function initGroupSelection() {
      const container = document.getElementById('groupOptionsContainer');
      container.innerHTML = TARGET_GROUPS.map((g, idx) => `
        <label class="relative flex items-center p-3 rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-slate-100 cursor-pointer transition has-[:checked]:border-indigo-600 has-[:checked]:bg-indigo-50/50">
          <input type="radio" name="groupRadio" value="${g.id}" ${idx === 0 ? 'checked' : ''} onchange="selectedGroupRadio = '${g.id}'" class="h-4 w-4 text-indigo-600 border-slate-300 focus:ring-indigo-500">
          <span class="ml-2.5 text-xs md:text-sm font-medium text-slate-800">${g.name}</span>
        </label>
      `).join('');
      selectedGroupRadio = TARGET_GROUPS[0].id;
    }

    // 관리자 필터 드롭다운 채우기
    function initFilterDropdowns() {
      const adminGroupFilter = document.getElementById('adminGroupFilter');
      const exportGroupFilter = document.getElementById('exportGroupFilter');
      
      const optionsHtml = TARGET_GROUPS.map(g => `<option value="${g.id}">${g.name}</option>`).join('');
      adminGroupFilter.innerHTML = '<option value="ALL">전체 단체 보기</option>' + optionsHtml;
      exportGroupFilter.innerHTML = '<option value="ALL">전체 단체 합본</option>' + optionsHtml;
    }

    // 폼 제출 핸들러 (작성 후 결과를 절대 보여주지 않고 감사 화면으로 전환)
    function handleSubmit(e) {
      e.preventDefault();

      const groupObj = TARGET_GROUPS.find(g => g.id === selectedGroupRadio);
      const eventVal = document.getElementById('eventSelect').value;
      const keepVal = document.getElementById('keepText').value.trim();
      const problemVal = document.getElementById('problemText').value.trim();
      const tryVal = document.getElementById('tryText').value.trim();
      const privateVal = document.getElementById('privateText').value.trim();

      if (!problemVal) {
        showToast("아쉬웠던 점 또는 개선할 점을 적어주세요.");
        return;
      }

      const now = new Date();
      const formattedDate = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')} ${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;

      const newEntry = {
        id: "fb-" + Date.now(),
        groupId: groupObj.id,
        groupName: groupObj.name,
        event: eventVal,
        keep: keepVal,
        problem: problemVal,
        tryText: tryVal,
        privateNote: privateVal,
        createdAt: formattedDate,
        refinedText: "",
        isReviewed: false
      };

      // 보좌신부 저장소에 추가
      feedbacks.unshift(newEntry);
      updateBadges();

      // 응답자 화면을 '제출 완료 감사 카드'로 전환하여 타인의 글이나 목록에 접근 불가하도록 차단
      document.getElementById('formSection').classList.add('hidden');
      document.getElementById('submitSuccessCard').classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
      lucide.createIcons();
    }

    // 추가 작성을 원하는 경우 폼 다시 표시
    function resetFormForNewSubmission() {
      document.getElementById('feedbackForm').reset();
      initGroupSelection();
      document.getElementById('submitSuccessCard').classList.add('hidden');
      document.getElementById('formSection').classList.remove('hidden');
      lucide.createIcons();
    }

    // 관리자 리스트 렌더링
    function renderAdminList() {
      const groupFilter = document.getElementById('adminGroupFilter').value;
      const statusFilter = document.getElementById('adminStatusFilter').value;
      const listContainer = document.getElementById('feedbackList');

      let filtered = feedbacks.filter(item => {
        if (groupFilter !== 'ALL' && item.groupId !== groupFilter) return false;
        if (statusFilter === 'PENDING' && item.isReviewed) return false;
        if (statusFilter === 'REVIEWED' && !item.isReviewed) return false;
        return true;
      });

      document.getElementById('totalCountBadge').textContent = `총 ${filtered.length}건`;

      if (filtered.length === 0) {
        listContainer.innerHTML = `
          <div class="text-center py-12 bg-white rounded-xl border border-slate-200 text-slate-400">
            <i data-lucide="filter-x" class="w-8 h-8 mx-auto mb-2 opacity-50"></i>
            <p class="text-xs">조건에 해당하는 피드백이 없습니다.</p>
          </div>
        `;
        lucide.createIcons();
        return;
      }

      listContainer.innerHTML = filtered.map(item => {
        const isSelected = item.id === selectedFeedbackId;
        const groupObj = TARGET_GROUPS.find(g => g.id === item.groupId);
        const badgeClass = groupObj ? groupObj.badge : "bg-slate-100 text-slate-700";

        return `
          <div onclick="selectFeedback('${item.id}')" class="p-4 rounded-xl border transition cursor-pointer ${isSelected ? 'bg-indigo-50/80 border-indigo-400 shadow-sm' : 'bg-white border-slate-200 hover:border-indigo-200 hover:shadow-sm'}">
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-[11px] font-semibold px-2 py-0.5 rounded border ${badgeClass}">
                ${item.groupName}
              </span>
              <div class="flex items-center gap-1.5">
                ${item.privateNote ? '<span title="비밀 메모 포함" class="text-purple-600"><i data-lucide="lock" class="w-3.5 h-3.5"></i></span>' : ''}
                <span class="text-[11px] px-2 py-0.5 rounded-full font-medium ${item.isReviewed ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}">
                  ${item.isReviewed ? '식별 완료' : '식별 대기'}
                </span>
              </div>
            </div>

            <h4 class="text-xs md:text-sm font-bold text-slate-900 truncate">
              ${item.event}
            </h4>
            
            <p class="text-xs text-slate-600 line-clamp-2 mt-1 leading-relaxed">
              ${item.problem}
            </p>

            <div class="flex items-center justify-between mt-2.5 pt-2 border-t border-slate-100 text-[11px] text-slate-400">
              <span>${item.createdAt}</span>
              ${item.refinedText ? '<span class="text-amber-700 font-medium">✨ 정제문 작성됨</span>' : '<span class="text-slate-400">원문 상태</span>'}
            </div>
          </div>
        `;
      }).join('');

      lucide.createIcons();
    }

    // 개별 피드백 선택
    function selectFeedback(id) {
      selectedFeedbackId = id;
      renderAdminList();

      const item = feedbacks.find(f => f.id === id);
      if (!item) return;

      const emptyState = document.getElementById('emptyEditorState');
      const activeContent = document.getElementById('activeEditorContent');
      emptyState.classList.add('hidden');
      activeContent.classList.remove('hidden');

      // 원문 필드 주입
      const groupObj = TARGET_GROUPS.find(g => g.id === item.groupId);
      const detailGroupBadge = document.getElementById('detailGroupBadge');
      detailGroupBadge.textContent = item.groupName;
      detailGroupBadge.className = `px-2.5 py-1 rounded-md text-xs font-semibold border ${groupObj ? groupObj.badge : ''}`;

      document.getElementById('detailDate').textContent = item.createdAt;
      document.getElementById('detailEventTitle').textContent = `[${item.event}] 관련 의견`;

      // KPT 원문 바인딩
      const rawKeepSection = document.getElementById('rawKeepSection');
      if (item.keep) {
        rawKeepSection.classList.remove('hidden');
        document.getElementById('detailKeep').textContent = item.keep;
      } else {
        rawKeepSection.classList.add('hidden');
      }

      document.getElementById('detailProblem').textContent = item.problem;

      const rawTrySection = document.getElementById('rawTrySection');
      if (item.tryText) {
        rawTrySection.classList.remove('hidden');
        document.getElementById('detailTry').textContent = item.tryText;
      } else {
        rawTrySection.classList.add('hidden');
      }

      // 비밀 메모 여부
      const privateContainer = document.getElementById('detailPrivateContainer');
      if (item.privateNote) {
        privateContainer.classList.remove('hidden');
        document.getElementById('detailPrivate').textContent = item.privateNote;
      } else {
        privateContainer.classList.add('hidden');
      }

      // 신부님 정제 필드 바인딩
      document.getElementById('refinedFeedbackText').value = item.refinedText || '';
      document.getElementById('markAsReviewedCheck').checked = item.isReviewed;

      lucide.createIcons();
    }

    // 신부님 식별 내용 저장
    function saveDiscernment() {
      if (!selectedFeedbackId) return;

      const item = feedbacks.find(f => f.id === selectedFeedbackId);
      if (!item) return;

      const refined = document.getElementById('refinedFeedbackText').value.trim();
      const isReviewed = document.getElementById('markAsReviewedCheck').checked;

      item.refinedText = refined;
      item.isReviewed = isReviewed;

      updateBadges();
      renderAdminList();
      showToast("사목 식별 및 정제 내용이 저장되었습니다.");
    }

    // 템플릿 문구 자동 삽입 도우미
    function insertRefinedTemplate(type) {
      const textarea = document.getElementById('refinedFeedbackText');
      let textToAppend = "";
      switch (type) {
        case 'communication':
          textToAppend = "[사목적 소통 체계 보완] 교리 및 본당 행사 관련 안내 시, 학부모 및 봉사자들의 의견 수렴과 사전 공지 일정을 충분히 확보하여 상호 오해 없는 온화한 소통 문화 조성 필요.";
          break;
        case 'time':
          textToAppend = "[일정 및 공지 사전화] 각 행사 세부 시간표와 봉사자 역할 안내를 최소 2주 전 사전 확정하여 공유하는 체계 마련 필요.";
          break;
        case 'role':
          textToAppend = "[역할 분담] 교사회와 자모회의 지원 영역을 문서화하여 행사 당일 혼선과 특정 단체의 과중한 부담 방지.";
          break;
        case 'budget':
          textToAppend = "[예산 및 물품] 행사 1개월 전 물품 체크리스트 및 소요 예산을 미리 책정하여 당일 부족 사태 예방.";
          break;
        case 'keep':
          textToAppend = "[우수 사례 지속] 봉사자들의 자발적 헌신과 유기적인 소통으로 참여 청소년들의 만족도가 매우 높았음. 다음 사목에도 본 방식 적극 유지 권장.";
          break;
      }
      if (textarea.value) {
        textarea.value += "\n" + textToAppend;
      } else {
        textarea.value = textToAppend;
      }
    }

    // 빠른 토픽 칩 클릭 시 입력창에 즉시 입력
    function setQuickTopic(topic) {
      const input = document.getElementById('eventSelect');
      input.value = topic;
      input.focus();
    }

    // 미식별 건수 뱃지 업데이트
    function updateBadges() {
      const pendingCount = feedbacks.filter(f => !f.isReviewed).length;
      const badge = document.getElementById('badgeCount');
      if (pendingCount > 0) {
        badge.textContent = pendingCount;
        badge.classList.remove('hidden');
      } else {
        badge.classList.add('hidden');
      }
    }

    // 보고서 생성 모달
    function openExportModal() {
      document.getElementById('exportModal').classList.remove('hidden');
      generateReportText();
      lucide.createIcons();
    }

    function closeExportModal() {
      document.getElementById('exportModal').classList.add('hidden');
    }

    function generateReportText() {
      const filterGroup = document.getElementById('exportGroupFilter').value;
      const filtered = feedbacks.filter(item => {
        if (!item.isReviewed || !item.refinedText) return false;
        if (filterGroup !== 'ALL' && item.groupId !== filterGroup) return false;
        return true;
      });

      document.getElementById('exportCountText').textContent = `정제 완료 ${filtered.length}건 반영`;

      const targetGroupName = filterGroup === 'ALL' ? '청소년 사목 전체 공동체' : (TARGET_GROUPS.find(g => g.id === filterGroup)?.name || '');

      let text = `=========================================\n`;
      text += `✝️ [${targetGroupName}] 사목 피드백 & 결산 안내\n`;
      text += `담당 사제: 보좌신부 식별 및 정제 완료본\n`;
      text += `작성일시: ${new Date().toLocaleDateString('ko-KR')}\n`;
      text += `=========================================\n\n`;
      text += `본 내용은 1년 동안 수렴된 교사, 자모, 청년들의 의견을\n보좌신부가 사목적으로 묵상·정제하여 함께 나누는 제안입니다.\n\n`;

      if (filtered.length === 0) {
        text += `(선택된 단체의 식별 및 정제 완료된 피드백이 아직 없습니다. 에디터에서 정제문을 저장해주세요.)`;
      } else {
        // 그룹별로 묶어 표시
        const grouped = {};
        filtered.forEach(f => {
          if (!grouped[f.groupName]) grouped[f.groupName] = [];
          grouped[f.groupName].push(f);
        });

        for (const [grpName, items] of Object.entries(grouped)) {
          text += `■ [${grpName}]\n`;
          items.forEach((item, i) => {
            text += `  ${i + 1}. [${item.event}]\n`;
            text += `     ${item.refinedText.replace(/\n/g, '\n     ')}\n\n`;
          });
        }
      }

      text += `\n"너희는 서로 남의 짐을 져 주십시오. 그렇게 하여 그리스도의 법을 완수하십시오." (갈라 6,2)\n`;

      document.getElementById('reportOutputArea').value = text;
    }

    function copyReportToClipboard() {
      const area = document.getElementById('reportOutputArea');
      area.select();
      navigator.clipboard.writeText(area.value).then(() => {
        const toastSpan = document.getElementById('copyToast');
        toastSpan.style.opacity = '1';
        setTimeout(() => {
          toastSpan.style.opacity = '0';
        }, 2000);
      });
    }

    // 간단한 토스트 알림창
    function showToast(msg) {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toastMsg');
      toastMsg.textContent = msg;
      toast.classList.remove('translate-y-16', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');

      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-16', 'opacity-0');
      }, 3000);
    }
  </script>
</body>
</html>
